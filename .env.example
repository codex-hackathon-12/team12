# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# GitHub OAuth App > Client ID and Client Secret
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Required by the Vercel Workflow that generates portfolio content.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Set to http in Vercel to use the deployed REST API instead of mock data.
NEXT_PUBLIC_API_MODE=http
